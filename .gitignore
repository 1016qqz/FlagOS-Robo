# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtual envs
.venv/
venv/
env/

# Experiment / runtime outputs
outputs/
logs/
wandb/
checkpoints/
*.log

# Local scratch: probes, one-off acceptance drivers, negative-control fixtures.
# Reproducible commands live in docs/, so scratch drivers are deliberately
# NOT part of the deliverable.
_scratch/

# Vendored upstream clone. docs/MIGRATION_SOP.md tells you to clone FlagScale
# into _ci/FlagScale as the --source-root for the closure gate; it is a working
# copy of someone else's repo and must never be committed here. Note the
# traversal gates prune it too (tools/check_all_dangling.py _PRUNE) — see
# MIGRATION_SOP.md §2.2.
_ci/

# Editor / OS
.vscode/
.idea/
.DS_Store
